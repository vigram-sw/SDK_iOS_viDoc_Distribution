{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"text":"Actual version release","level":3,"type":"heading","anchor":"Actual-version-release"},{"text":"Summary","level":2,"type":"heading","anchor":"Summary"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"2.0.0-rc.1"},{"type":"text","text":" improves Bluetooth stability, authentication handling and privacy manifest integration."}]},{"text":"Breaking Changes","level":2,"type":"heading","anchor":"Breaking-Changes"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Legacy peripheral logging APIs are no longer available."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"NTRIP connection state has new reconnect cases, so exhaustive "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" statements may need updates."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single Point measurement errors have new cases, so exhaustive "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" statements may need updates."}]}]}]},{"text":"Added","level":2,"type":"heading","anchor":"Added"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Structured support logging through "},{"type":"codeVoice","code":"Vigram.Logger(url:mode:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"JSON Lines support log format for easier support analysis."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatic NTRIP reconnect, enabled by default."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"NTRIP reconnect progress states."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate HTTPS flags for NTRIP mountpoints and correction stream."}]}]},{"content":[{"type":"paragraph","i