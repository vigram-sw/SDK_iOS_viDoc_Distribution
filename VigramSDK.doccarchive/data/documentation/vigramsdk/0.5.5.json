{"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"primaryContentSections":[{"content":[{"anchor":"What-is-the-new-on-this-release","level":2,"text":"What is the new on this release","type":"heading"},{"anchor":"Peripheral","level":4,"text":"Peripheral","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Added Dynamic state"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"If needed to set the dynamic state of viDoc perform the method"}],"type":"paragraph"},{"code":["peripheral.setDynamicState(type: type)","    .sink(receiveCompletion: { completion in ","        \/\/ do something with completion state","    }) { messageIsAcknowledgeValue in ","        \/\/ do something with receive value","    }","    .store(in: &subscription)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If needed to get the dynamic state of viDoc perform the method"}],"type":"paragraph"},{"code":["peripheral.getCurrentDynamicState()","    .sink(receiveCompletion: { completion in ","        \/\/ do something with completion state","    }) { value in","        switch state.current {","        case .pedestrian:","            \/\/ do something","        case .stationary:","            \/\/ do something","        @unknown default:","            break","        }","    }","    .store(in: &subscription)"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Added the ability to update the viDoc software."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"If needed to check if a software update is needed use this variables"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Local firmware update is available through a firmware file bundled or selected by the host app."},{"type":"text","text":" "},{"type":"text","text":"The update process starts on the next device restart after the local firmware payload is prepared."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use the following variables to control the upgrade process"}],"type":"paragraph"},{"code":["var errorWrite: Bool ","var stateSoftwareUpdate: StatePublisher<StateUpdateSoftware> ","var progressSoftwareUpdate: StatePublisher<Double> "],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Changed enum value from"}]}]}],"type":"unorderedList"},{"code":["StateUpdateSoftware.startUpdate"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"on"}],"type":"paragraph"},{"code":["StateUpdateSoftware.startUpdate(DeviceMessage.Version.Software)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"where DeviceMessage.Version.Software is the version of the software being installed"}],"type":"paragraph"},{"level":4,"type":"heading","anchor":"SinglePoint","text":"SinglePoint"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Added the ability to use pedestrian state of viDoc for SinglePoint measurent","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to use pedestrian or stationary dynamic state mode viDoc with SinglePoint measurements use this init"}]},{"code":["\/\/ Init without laser","let singlePointService: SinglePointRecordingService = ","    Vigram.singlePointRecordingService(","        gpsService: GPSService, ","        peripheral: Peripheral, ","        dynamicStateType: DynamicStateType","    )","","\/\/ Init with laser","let singlePointService: SinglePointRecordingService = ","    Vigram.singlePointRecordingService(","        gpsService: GPSService, ","        laserService: LaserService, ","        peripheral: Peripheral, ","        dynamicStateType: DynamicStateType","    )"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"schemaVersion":{"patch":0