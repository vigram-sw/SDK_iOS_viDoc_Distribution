{"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"","level":2,"text":"","type":"heading"},{"inlineContent":[{"type":"text","text":"This section provides a detailed description of errors that may occur while using the SDK."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/AuthenticationError","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"These errors can be received when using "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Authentication","isActive":true}],"type":"paragraph"},{"syntax":"swift","code":["public enum AuthenticationError: Swift.Error {","","    \/\/ Error authentication - bundle is not exist","    case bundleNotExist(String)","","    \/\/ Error authentication - token is not exist","    case tokenNotExist(String)","","    \/\/ Error authentication - wrong combination ","    \/\/ bundle and token is incorrect)","    case wrongTokenAndBundle(String)","","    \/\/ Error authentication - wrong combination ","    \/\/ (bundle, token or platformId is incorrect)","    case wrongCombination(String)","","    \/\/ Authentication is failure - Other error received ","    \/\/ from server","    case failure(String)","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralError","isActive":true,"type":"reference"}]}]}],"type":"unorderedList"},{"inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralError","isActive":true,"type":"reference"},{"type":"text","text":" combines different failure events that can be emitted on sending data to a "},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Peripheral","isActive":true,"type":"reference"}],"type":"paragraph"},{"code":["public enum PeripheralError: Swift.Error {","","    \/\/ The peripheral does not have a characteristic to write to.","    \/\/ Note: This error might be thrown, when we did not yet gather ","    \/\/ enough characteristics of the peripheral.","    case characteristicNotFound","","    \/\/ A send request is aborted, since the peripheral has already ","    \/\/ been deallocated.","    \/\/ Since VigramSDK is waiting for all previous messages to be ","    \/\/ sent before attempting","    \/\/ to send a message, it might already be deallocated when trying ","    \/\/ to send a message.","    case alreadyDeallocated","","    \/\/ Laser measurements not available in PPK mode","    case laserNotAvailableInPPK","","    \/\/ BLE write timeout exceeded.","    case writeTimeOut","","    \/\/ The configuration of the peripheral failed unexpectedly.","    case configurationFailed","    ","    \/\/ This method is not supported in current software version ","    \/\/ of the RTK device","    case requestIsNotSupported(String)","    ","    \/\/ This method is not available in this case","    case accessDenied(String)","    ","    \/\/ The current RTK device is incompatible in this SDK version","    case deviceNumberIsIncompatible","    ","    \/\/ The current software of the connected RTK device is ","    \/\/ incompatible in this SDK version","    case deviceSoftwareIsIncompatible","    ","    \/\/ Is not possible to perform the request. Device is configuring","    \/\/ in this time.","    case deviceIsBusy(String)","","    \/\/ The current version of SDK is outdated","    case sdkIsOutdated","","    \/\/ The verification of SDK is failure","    case verificationFailure(String)","","    \/\/ The unknown error","    case unknownError(String)","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/BluetoothServiceError","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/BluetoothServiceError","isActive":true,"type":"reference"},{"text":" lists different errors that can be propagated by ","type":"text"},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/BluetoothService","isActive":true,"type":"reference"},{"text":" implementations.","type":"text"}],"type":"paragraph"},{"code":["public enum BluetoothServiceError: Error {","","    \/\/ The device to connect to cannot be found, since it is","    \/\/ (possibly no longer) available.","    case notAvailable(UUID)","","    \/\/ Connecting to a device failed unexplicably.","    case notConnected(UUID)","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripServiceError"}]}]}],"type":"unorderedList"},{"inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripServiceError","type":"reference","isActive":true},{"type":"text","text":" contains custom failure events when connecting to Ntrip services."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Note:","type":"text"}]},{"text":" It is not ensured that calls to ","type":"text"},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripService","type":"reference","isActive":true},{"text":" can only result in ","type":"text"},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripServiceError","type":"reference","isActive":true},{"text":" events.","type":"text"}],"type":"paragraph"},{"code":["public enum NtripServiceError: Swift.Error {","","    \/\/ Mountpoints could not be decoded from the received data.","    case mountPointDecodingFailed","","    \/\/ Creating the URL to connect to Ntrip endpoints did not succeed.","    case couldNotCreateURL(NtripConnectionInformation, ","                           mountPoint: String?)","","    \/\/ We could not create an Ntrip task due to unexplicable ","    \/\/ circumstances.","    \/\/ Note: This error should never be thrown.","    case couldNotCreateTask","","    \/\/ Adding authentication to a URLRequest did not succeed.","    case couldNotAddAuthentication(URLRequest, username: String, ","                                   password: String)","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripTaskError"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripTaskError"},{"type":"text","text":" lists different errors that can be emitted by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripTask"},{"type":"text","text":" implementations."}],"type":"paragraph"},{"code":["public enum NtripTaskError: Swift.Error {","","    \/\/ Creating the Ntrip network request failed.","    case couldNotCreateRequest","","    \/\/ Failed due to no data","    case noData","","    \/\/ Ntrip connection information (domain, port, or cridential) ","    \/\/ is incorrect","    case incorrectNCI","","    \/\/ Other error, received from RTCM message","    case failed(String)","","    \/\/ HTTP response error, received from server","    case httpResponceError(String)","","    \/\/ Server is not responding","    case serverIsNotResponce","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePointRecordingError","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePointRecordingError","type":"reference"},{"text":" are thrown, when due to the filtering phase of single point recordings there is not enough valid data to create a singlePoint. To investigate possible issues with the measurement, have a look at the provided associated data.","type":"text"}],"type":"paragraph"},{"code":["public enum SinglePointRecordingError: Error, Hashable {","","\/\/ The measurement failed due to too much filtered, non-valid data","\/\/","\/\/ Available in SDK ver. 1.0.3","case nonValidData","","\/\/ This method is not supported in current software version of the RTK device","\/\/","\/\/ Available in SDK ver. 1.0.3","case requestIsNotSupported(String)","","\/\/ The correction method used has incorrect settings","\/\/ Most likely the CoordinateCorrectionMethod settings ","\/\/ were not selected and passed to the write method correctly","\/\/","\/\/ Available in SDK ver. 1.0.3","case incorrectCoordinateCorrectionMethod(String)","","\/\/ Running measurement process not found","\/\/","\/\/ Available in SDK ver. 1.0.3","case noRunningMeasurementMethod","","\/\/ The value of horizontal accuracy is too high","\/\/ Hor.Accuracy < Configuration.maximumSinglePointHorizontalAccuracy","\/\/","\/\/ Available in SDK ver. 1.0.3","case horizontalAccuracyIsTooHigh","","\/\/ The value of vertical accuracy is too high","\/\/ Vert.Accuracy < Configuration.maximumSinglePointVerticalAccuracy","\/\/","\/\/ Available in SDK ver. 1.0.3","case verticalAccuracyIsTooHigh","","\/\/ The value of altitude difference is too high","\/\/ Altitude < Configuration.maximumSinglePointAltitudeDifference","\/\/","\/\/ Available in SDK ver. 1.0.3","case altitudeDifferenceIsTooHigh","","\/\/ The laser measurements are of bad quality","\/\/","\/\/ This means that most of the laser measurements were of bad ","\/\/ quality or incorrect.","\/\/","\/\/ Available in SDK ver. 1.0.3","case laserMeasurementsIsBadQuality","","\/\/ The measurement cancelled by user.","case measurementCancelled","","\/\/ Deprecated!","\/\/","\/\/ The measurement failed due to too much filtered, non-valid data","\/\/ Most of the measured data have low accuracy.","\/\/ e.g. One or more conditions are not met","\/\/ Hor.Accuracy < Configuration.maximumSinglePointHorizontalAccuracy,","\/\/ Vert.Accuracy < Configuration.maximumSinglePointVerticalAccuracy","\/\/ Altitude < Configuration.maximumSinglePointAltitudeDifference","\/\/ The returned RAW value of this error is the received measurements.","\/\/","\/\/ This error was used in older versions of SDK. Will not be","\/\/ supported in the future","case badMeasurement([EnvironmentData])","","\/\/ Deprecated!","\/\/","\/\/ The measurement failure.","\/\/ In most cases this error is not returned. ","\/\/ If you get it, check if you passed the correct ","\/\/ CoordinateCorrection.Method to the SinglePointRecordingService ","\/\/ measurement procedure (record or startMeasurements).","\/\/","\/\/ This error was used in older versions of SDK. Will not be","\/\/ supported in the future","case measurementFailure","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SDKErrorsAndExceptions"},"metadata":{"roleHeading":"Article","title":"SDK Errors and exceptions","modules":[{"name":"VigramSDK"}],"images":[{"identifier":"logo.png","type":"icon"}],"role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vigramsdk\/sdkerrorsandexceptions"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://com.vigram.sdk/documentation/VigramSDK/BluetoothServiceError":{"url":"\/documentation\/vigramsdk\/bluetoothserviceerror","abstract":[{"text":"BluetoothServiceError lists different errors that can be propagated by ","type":"text"},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/BluetoothService","type":"reference","isActive":true},{"text":" implementations.","type":"