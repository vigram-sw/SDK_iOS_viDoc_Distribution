{"primaryContentSections":[{"content":[{"level":2,"text":"","anchor":"","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The viDoc reset procedure returns the settings to factory defaults."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Note:","type":"text"}],"type":"strong"},{"type":"text","text":" Perform this procedure only if absolutely necessary."}]},{"name":"Note","content":[{"inlineContent":[{"text":"The reset procedure takes approximately 1 minute.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"At the beginning of the process, all messages are interrupted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Disconnection from all satellites occurs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"After the viDoc is reset, sending messages resumes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You must wait to receive the full NMEA GGA message.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To track the reset process, you need to use publisher"}]},{"code":["private var cancellables = Set<AnyCancellable>()","","peripheral.viDocResetState","    .sink(receiveCompletion: { completion in","        switch completion {","        case .finished:","            break \/\/ normal completion","        case .failure(let error):","            \/\/ do something with error","        }","    }) { [weak self] viDocResetState in","            switch viDocResetState {","            case let .isReseting(value):","                if value {","                    \/\/ reset in progress","                } else {","                    \/\/ reset is finished","                }","            case .failure: ","                \/\/ Error of reset viDoc","                break","            }","    }.store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To start the reset process, you need to perform the following method:"}]},{"code":["peripheral.resetViDoc()"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vigramsdk\/useresetvidoc"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"VigramSDK"}],"title":"Use Reset viDoc","images":[{"type":"icon","identifier":"logo.png"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseResetVidoc","interfaceLanguage":"swift"},"references":{"logo.png":{"identifier":"logo.png","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}],"alt":"Vigram logo.","type":"image"},"doc://com.vigram.sdk/documentation/VigramSDK":{"type":"topic","url":"\/documentation\/vigramsdk","role":"collection","abstract":[],"kind":"symbol","images":[{"type":"icon","identifier":"logo.png"}],"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","title":"VigramSDK"}}}