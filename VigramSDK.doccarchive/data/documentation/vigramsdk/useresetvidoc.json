{"metadata":{"modules":[{"name":"VigramSDK"}],"title":"Use Reset viDoc","role":"article","images":[{"type":"icon","identifier":"logo.png"}],"roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","identifier":{"url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseResetVidoc","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/vigramsdk\/useresetvidoc"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"","anchor":""},{"inlineContent":[{"type":"text","text":"The viDoc reset procedure returns the settings to factory defaults."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" Perform this procedure only if absolutely necessary."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The reset procedure takes approximately 1 minute."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the beginning of the process, all messages are interrupted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Disconnection from all satellites occurs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After the viDoc is reset, sending messages resumes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must wait to receive the full NMEA GGA message."}]}],"type":"aside","name":"Note"},{"inlineContent":[{"type":"text","text":"To track the reset process, you need to use publisher"}],"type":"paragraph"},{"code":["private var cancellables = Set<AnyCancellable>()","","peripheral.viDocResetState","    .sink(receiveCompletion: { completion in","        switch completion {","        case .finished:","            break \/\/ normal completion","        case .failure(let error):","            \/\/ do something with error","        }","    }) { [weak self] viDocResetState in","            switch viDocResetState {","            case let .isReseting(value):","                if value {","                    \/\/ reset in progress","                } else {","                    \/\/ reset is finished","                }","            case .failure: ","                \/\/ Error of reset viDoc","                break","            }","    }.store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To start the reset process, you need to perform the following method:"}]},{"type":"codeListing","syntax":"swift","code":["peripheral.resetViDoc()"]}],"kind":"content"}],"references":{"doc://com.vigram.sdk/documentation/VigramSDK":{"role":"collection","kind":"symbol","abstract":[],"type":"topic","images":[{"type":"icon","identifier":"logo.png"}],"url":"\/documentation\/vigramsdk","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","title":"VigramSDK"},"logo.png":{"alt":"Vigram logo.","type":"image","identifier":"logo.png","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}]}}}