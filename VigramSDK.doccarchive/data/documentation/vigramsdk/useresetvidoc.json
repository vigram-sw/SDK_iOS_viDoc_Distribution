{"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Use Reset viDoc","images":[{"identifier":"logo.png","type":"icon"}],"modules":[{"name":"VigramSDK"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vigramsdk\/useresetvidoc"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"","text":""},{"type":"paragraph","inlineContent":[{"type":"text","text":"The viDoc reset procedure returns the settings to factory defaults."}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Note:"}]},{"type":"text","text":" Perform this procedure only if absolutely necessary."}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The reset procedure takes approximately 1 minute.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At the beginning of the process, all messages are interrupted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Disconnection from all satellites occurs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After the viDoc is reset, sending messages resumes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You must wait to receive the full NMEA GGA message."}]}],"style":"note","name":"Note"},{"inlineContent":[{"text":"To track the reset process, you need to use publisher","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["private var cancellables = Set<AnyCancellable>()","","peripheral.viDocResetState","    .sink(receiveCompletion: { completion in","        switch completion {","        case .finished:","            break \/\/ normal completion","        case .failure(let error):","            \/\/ do something with error","        }","    }) { [weak self] viDocResetState in","            switch viDocResetState {","            case let .isReseting(value):","                if value {","                    \/\/ reset in progress","                } else {","                    \/\/ reset is finished","                }","            case .failure: ","                \/\/ Error of reset viDoc","                break","            }","    }.store(in: &cancellables)"],"syntax":"swift"},{"inlineContent":[{"text":"To start the reset process, you need to perform the following method:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["peripheral.resetViDoc()"],"syntax":"swift"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseResetVidoc","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"kind":"article","references":{"doc://com.vigram.sdk/documentation/VigramSDK":{"images":[{"type":"icon","identifier":"logo.png"}],"url":"\/documentation\/vigramsdk","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","type":"topic","kind":"symbol","abstract":[],"role":"collection","title":"VigramSDK"},"logo.png":{"alt":"Vigram logo.","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}],"identifier":"logo.png","type":"image"}}}