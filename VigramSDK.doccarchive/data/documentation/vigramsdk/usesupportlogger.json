{"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"","text":"","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create one structured support logger file and let the SDK write JSON Lines ("},{"code":".jsonl","type":"codeVoice"},{"type":"text","text":") into it."},{"type":"text","text":" "},{"type":"text","text":"Example:"}]},{"code":["var path: URL? \/\/ Path for logger file.","\/\/ For example let file = \"basic_17.04.2026-21:18:12.jsonl\"","let file = \"Filename\" + \".\" + \"file extension\" ","","let fileManager = FileManager.default","let directory = fileManager.urls(for: .documentDirectory, ","                                 in: .userDomainMask)","","if directory.count != 0  {","    path = directory[0].appendingPathComponent(\"Name directory\")","    if let path = path?.path {","        if !fileManager.fileExists(atPath: path) {","            do {","                try fileManager.createDirectory(atPath: path, ","                        withIntermediateDirectories: true, ","                        attributes: nil)","            } catch {","                print(\"Error: \\(error.localizedDescription)\")","            }","        }","    }","    path = path?.appendingPathComponent(file)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After that, configure the SDK logger once:"}]},{"code":["if let path {","    try Vigram.Logger(url: path, mode: .basic)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need a deeper trace for support, switch to diagnostic mode:"}]},{"code":["if let path {","    try Vigram.Logger(url: path, mode: .diagnostic)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK writes structured support events into this file automatically."}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","images":[{"identifier":"logo.png","type":"icon"}],"role":"article","title":"Use Support Logger","modules":[{"name":"VigramSDK"}]},"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vigramsdk\/usesupportlogger"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseSupportLogger"},"references":{"logo.png":{"identifier":"logo.png","type":"image","alt":"Vigram logo.","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}]},"doc://com.vigram.sdk/documentation/VigramSDK":{"type":"topic","url":"\/documentation\/vigramsdk","role":"collection","abstract":[],"kind":"symbol","images":[{"type":"icon","identifier":"logo.png"}],"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","title":"VigramSDK"}}}