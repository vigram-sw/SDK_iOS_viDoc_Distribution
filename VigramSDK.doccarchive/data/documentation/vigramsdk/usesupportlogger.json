{"metadata":{"modules":[{"name":"VigramSDK"}],"images":[{"type":"icon","identifier":"logo.png"}],"roleHeading":"Article","role":"article","title":"Use Support Logger"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseSupportLogger"},"variants":[{"paths":["\/documentation\/vigramsdk\/usesupportlogger"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"","text":""},{"type":"paragraph","inlineContent":[{"text":"Create one structured support logger file and let the SDK write JSON Lines (","type":"text"},{"type":"codeVoice","code":".jsonl"},{"text":") into it.","type":"text"},{"text":" ","type":"text"},{"text":"Example:","type":"text"}]},{"type":"codeListing","code":["var path: URL? \/\/ Path for logger file.","\/\/ For example let file = \"basic_17.04.2026-21:18:12.jsonl\"","let file = \"Filename\" + \".\" + \"file extension\" ","","let fileManager = FileManager.default","let directory = fileManager.urls(for: .documentDirectory, ","                                 in: .userDomainMask)","","if directory.count != 0  {","    path = directory[0].appendingPathComponent(\"Name directory\")","    if let path = path?.path {","        if !fileManager.fileExists(atPath: path) {","            do {","                try fileManager.createDirectory(atPath: path, ","                        withIntermediateDirectories: true, ","                        attributes: nil)","            } catch {","                print(\"Error: \\(error.localizedDescription)\")","            }","        }","    }","    path = path?.appendingPathComponent(file)","}"],"syntax":"swift"},{"inlineContent":[{"text":"After that, configure the SDK logger once:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let path {","    try Vigram.Logger(url: path, mode: .basic)","}"]},{"inlineContent":[{"type":"text","text":"If you need a deeper trace for support, switch to diagnostic mode:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if let path {","    try Vigram.Logger(url: path, mode: .diagnostic)","}"]},{"inlineContent":[{"type":"text","text":"The SDK writes structured support events into this file automatically."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.vigram.sdk/documentation/VigramSDK":{"role":"collection","kind":"symbol","abstract":[],"type":"topic","images":[{"type":"icon","identifier":"logo.png"}],"url":"\/documentation\/vigramsdk","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","title":"VigramSDK"},"logo.png":{"alt":"Vigram logo.","variants":[{"traits":["1x","light"],"url":"\/images\/com.vigram.sdk\/logo.png"}],"type":"image","identifier":"logo.png"}}}