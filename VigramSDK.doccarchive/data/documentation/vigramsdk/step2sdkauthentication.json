{"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"VigramSDK is copyrighted and licensed. Therefore, in order to be able to use it, you need to obtain an authentication token. Please contact Vigram AG support to receive a token.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Authentication check is performed when calling any VigramSDK service:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"fig12.png"}]},{"type":"paragraph","inlineContent":[{"text":"If the authentication procedure is not completed, access to the SDK functions will not be available","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"First, to use the SDK, you must be authenticated.","type":"text"},{"text":" ","type":"text"},{"text":"Creates a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Authentication"},{"text":" object to check your token.","type":"text"}]},{"type":"codeListing","code":["import Combine","import VigramSDK","","final class YouVigramHelper: NSObject {","    let authentication: AnyCancellable?","","    public init() {","        super.init()","        authentication = Vigram.initial(token: \"your token\")","            .check()","            .receive(on: DispatchQueue.main)","            .sink(receiveCompletion: { completion in","                switch completion {","                case .finished:","                    break \/\/ normal receive value","                case .failure(let error):","                    \/\/ failure to receive value","                    \/\/ do something with error publisher","                    print(error.localizedDescription)","                }","            }) { [weak self] resultAuthentication in","                switch resultAuthentication {","                    case .success:","                        \/\/ do something after successful authentication","                        \/\/ for example init Vigram services and","                        \/\/ start bluetooth scanning after that","                    case .failure(let error):","                        \/\/ do something with error authentication","                        print(error.localizedDescription)","                }","            }","    }","","    deinit {","        authentication = nil","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Return value:"}],"type":"strong"},{"text":" Result<Bool, AuthenticationError>","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Throw error:"}],"type":"strong"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/AuthenticationError"}]},{"type":"heading","level":3,"anchor":"","text":""},{"type":"paragraph","inlineContent":[{"text":"It is recommended to place the authentication call in the initialization of your Vigram helper class to avoid missing the token expiration date (20 days offline).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This completes the authentication procedure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The next step is ","type":"text"},{"inlineContent":[{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"change the configuration parameters."}],"isActive":true,"overridingTitle":"change the configuration parameters.","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step3ConfigurationParameters"}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"All methods and functions specified in this manual are also available in the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/vigram-sw\/SDK_iOS_viDoc_Distribution\/tree\/demo\/"}],"type":"emphasis"}]},{"type":"heading","level":3,"anchor":"More-information-about","text":"More information about"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/combine"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/documentation\/corebluetooth"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Using Combine and Publishers"}],"isActive":true,"overridingTitle":"Using Combine and Publishers","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseCombineAndPublishers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"SDK Errors and exceptions"}],"isActive":true,"overridingTitle":"SDK Errors and exceptions","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SDKErrorsAndExceptions"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitle":"Demo repository","type":"reference","identifier":"https:\/\/github.com\/vigram-sw\/SDK_iOS_viDoc_Distribution\/tree\/demo\/","isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Demo repository"}]}]}]}]},{"type":"heading","level":2,"anchor":"Navigation","text":"Navigation"},{"type":"paragraph","inlineContent":[{"overridingTitle":"Up to Getting started with VigramSDK","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/GettingStarted","type":"reference","isActive":true,"overridingTitleInlineContent":[{"text":"Up to Getting started with VigramSDK","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"overridingTitle":"✅ STEP 1 (Import VigramSDK)","identifier":"doc:\/\/com.vigram.sdk