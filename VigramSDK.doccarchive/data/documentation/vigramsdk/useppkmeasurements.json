{"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"","text":""},{"type":"paragraph","inlineContent":[{"text":"If you need use PPK Measurements first need to activate RXM messages, performing this method:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["peripheral.changeStatusRXM(activate: Bool)"]},{"type":"paragraph","inlineContent":[{"text":"Note: activate - enable \/ disable RXM messages","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To receive UBX-RXM-RAWX or UBX-RXM-SFRBX messages use:","type":"text"}]},{"code":["peripheral.satelliteMessages.sink(receiveValue: { satelliteMessage in","    switch satelliteMessage {","        case let .rawx(rawxMessage):","            \/\/ do something with rawxMessage","        case let .sfrbx(sfrbxMessage):","            \/\/ do something with sfrbxMessage","        default:","            break","        }","    }).store(in: &subscription)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If need to record PPK measurement to file, first create URL path for ubx file.","type":"text"},{"text":" ","type":"text"},{"text":"Example:","type":"text"}]},{"code":["var path: URL? \/\/ Path for logger file.","\/\/ For example let file = \"file.ubx\"","let file = \"Filename\" + \".\" + \"file extension\" ","","let fileManager = FileManager.default","let directory = fileManager.urls(","    for: .documentDirectory, ","    in: .userDomainMask",")","","if directory.count != 0  {","    path = directory[0].appendingPathComponent(\"Name directory\")","    if let path = path?.path {","        if !fileManager.fileExists(atPath: path) {","            do {","                try fileManager.createDirectory(","                    atPath: path, ","                    withIntermediateDirectories: true, ","                    attributes: nil","                )","            } catch {","                print(\"Error: \\(error.localizedDescription)\")","            }","        }","    }","    path = path?.appendingPathComponent(file)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"After then, start record measurements perform this method","type":"text"}]},{"code":["peripheral.startRecordPPKMeasurements(url: ubxFilePath)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Record is active.","type":"text"},{"text":" ","type":"text"},{"text":"If you need to stop record measurements perform this method","type":"text"}]},{"code":["peripheral.stopRecordPPKMeasurements()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"All messages will saving to file","type":"text"}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","images":[{"type":"icon","identifier":"logo.png"}],"role":"article","title":"Use UBX PPK Measurements","modules":[{"name":"VigramSDK"}]},"identifier":{"url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UsePPKMeasurements","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vigramsdk\/useppkmeasurements"]}],"references":{"doc://com.vigram.sdk/documentation/VigramSDK":{"type":"topic","url":"\/documentation\/vigramsdk","role":"collection","abstract":[],"kind":"symbol","images":[{"type":"icon","identifier":"logo.png"}],"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","title":"VigramSDK"},"logo.png":{"identifier":"logo.png","type":"image","alt":"Vigram logo.","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}]}}}