{"metadata":{"title":"Use Peripheral Configuration","roleHeading":"Article","images":[{"type":"icon","identifier":"logo.png"}],"role":"article","modules":[{"name":"VigramSDK"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UsePeripheralConfiguration"},"variants":[{"paths":["\/documentation\/vigramsdk\/useperipheralconfiguration"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"","anchor":""},{"inlineContent":[{"text":"If you need to disable some GNSS messages, change the message rate, or change the minimum elevation used in navigation parameters, create a ","type":"text"},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralConfiguration","type":"reference","isActive":true},{"type":"text","text":" and pass it to the peripheral initializer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Example:"}],"type":"paragraph"},{"type":"codeListing","code":["let peripheralConfiguration =","    PeripheralConfiguration(rateOfChangeMessages: .hertz1,","                            glonassActivate: false)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Then pass the configuration to the peripheral initializer:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ If use support logger, configure it once with Vigram.Logger(...)","\/\/ and then create the peripheral normally","let sdkPeripheral =","    Vigram.peripheral(cbPeripheral,","                      configuration: peripheralConfiguration)","","\/\/ Without a custom configuration","let defaultPeripheral = Vigram.peripheral(cbPeripheral)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Note: If this parameter is not passed to the initializer, all parameters will use their default values."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Message rate is set to 7 hertz","rateOfChangeMessages: RateValue = .hertz7","","\/\/ Minimum elevation used in navigation is set to 10 degrees","elevationValue: ElevationValue = .ang10,","","\/\/ All satellite constellations are active","glonassActivate = true","beidouActivate = true","galileoActivate = true","qzssActivate = true","sbassActivate = true","","\/\/ NAV-DOP and NAV-PVT messages are active","navDOPActivate = true","navPVTActivate = true","","\/\/ Dynamic state mode","dynamicType = .pedestrian"]}]}],"references":{"doc://com.vigram.sdk/documentation/VigramSDK/PeripheralConfiguration":{"navigatorTitle":[{"kind":"identifier","text":"PeripheralConfiguration"}],"type":"topic","url":"\/documentation\/vigramsdk\/peripheralconfiguration","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PeripheralConfiguration"}],"title":"PeripheralConfiguration","abstract":[{"type":"text","text":"Initial configuration for peripheral"}],"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralConfiguration","kind":"symbol"},"doc://com.vigram.sdk/documentation/VigramSDK":{"role":"collection","kind":"symbol","abstract":[],"type":"topic","images":[{"type":"icon","identifier":"logo.png"}],"url":"\/documentation\/vigramsdk","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","title":"VigramSDK"},"logo.png":{"type":"image","alt":"Vigram logo.","identifier":"logo.png","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}]}}}