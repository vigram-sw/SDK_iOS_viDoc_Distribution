{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step1GettingStarted"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To connect VigramSDK in this example we will use "},{"type":"reference","identifier":"https:\/\/www.swift.org\/package-manager\/","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"We also recommend using this method instead of CocoaPods."}]},{"anchor":"Step-1-Add-Package-Dependencies-in-your-project","type":"heading","text":"Step 1. Add Package Dependencies in your project.","level":2},{"type":"paragraph","inlineContent":[{"text":"To add a framework to your project, you need to select Add Package Dependencies in the ","type":"text"},{"type":"strong","inlineContent":[{"text":"File","type":"text"}]},{"text":" section of the top menu of Xcode:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"fig1.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paste into the search bar url:"}]},{"syntax":null,"code":["https:\/\/github.com\/vigram-sw\/SDK_iOS_viDoc_Distribution.git"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"fig2.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After entering the address, the SDK name, the current release version, and the project to which the library will be added will appear:"}]},{"type":"paragraph","inlineContent":[{"identifier":"fig3.png","type":"image"}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"Make sure you have access to an internet connection and that the project you are adding the framework to is selected correctly","type":"text"},{"text":" ","type":"text"},{"text":"Also pay attention to the rel