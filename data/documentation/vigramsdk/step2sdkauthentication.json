{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step2SDKAuthentication"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"VigramSDK is copyrighted and licensed. Therefore, in order to be able to use it, you need to obtain an authentication token. Please contact Vigram AG support to receive a token.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Authentication check is performed when calling any VigramSDK service:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"fig12.png"}]},{"type":"paragraph","inlineContent":[{"text":"If the authentication procedure is not completed, access to the SDK functions will not be available","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"First, to use the SDK, you must be authenticated.","type":"text"},{"text":" ","type":"text"},{"text":"Creates a ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Authentication","isActive":true},{"text":" object to check your token.","type":"text"}]},{"type":"codeListing","code":["import Combine","import VigramSDK","","final class YouVigramHelper: NSObject {","    let authentication: AnyCancellable?","","    public init() {","        super.init()","        authentication = Vigram.initial(token: \"your token\")","            .check()","            .receive(on: DispatchQueue.main)","            .sink(receiveCompletion: { completion in","                switch completion {","                case .finished:","                    break \/\/ normal receive value","                case .failure(let error):","                    \/\/ failure to receive value","                    \/\/ do something with error publisher","                    print(error.localizedDescription)","                }","            }) { [weak self] resultAuthentication in","                switch resultAuthentication {","                    case .success:","                        \/\/ do something after successful authentication","                        \/\/ for example init Vigram services and","                        \/\/ start bluetooth scanning after that","                    case .failure(let error):","                        \/\/ do something with error authentication","                        print(error.localizedDescription)","                }","            }","    }","","    deinit {","        authentication = nil","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Return value:","type":"text"}]},{"type":"text","text":" Result<Bool, AuthenticationError>"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Throw error:","type":"text"}]},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/AuthenticationError"}]},{"anchor":"","type":"heading","text":"","level":3},{"type":"paragraph","inlineContent":[{"text":"It is recommended to place the authentication call in the initialization of your Vigram helper class to avoid missing the token expiration date (20 days offline).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This completes the authentication procedure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The next step is "},{"type":"strong","inlineContent":[{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"change the configuration parameters."}],"overridingTitle":"change the configuration parameters.","type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step3ConfigurationParameters"}]}]},{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"All methods and functions specified in this manual are also available in the "},{"type":"reference","identifier":"https:\/\/github.com\/vigram-sw\/SDK_iOS_viDoc_Distribution\/tree\/demo\/","isActive":true}]}]},{"anchor":"More-information-about","type":"heading","text":"More information about","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/combine","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"https:\/\/developer.apple.com\/documentation\/corebluetooth","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"Using Combine and Publishers","type":"text"}],"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseCombineAndPublishers","isActive":true,"overridingTitle":"Using Combine and Publishers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SDKErrorsAndExceptions","overridingTitleInlineContent":[{"type":"text","text":"SDK Errors and exceptions"}],"type":"reference","overridingTitle":"SDK Errors and exceptions"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"Demo repository","type":"text"}],"type":"reference","identifier":"https:\/\/github.com\/vigram-sw\/SDK_iOS_viDoc_Distribution\/tree\/demo\/","isActive":true,"overridingTitle":"Demo repository"}]}]}]},{"anchor":"Navigation","type":"heading","text":"Navigation","level":2},{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"Up to Getting started with VigramSDK","type":"text"}],"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/GettingStarted","isActive":true,"overridingTitle":"Up to Getting started with VigramSDK"}]},{"type":"paragraph","inlineContent":[{"overr