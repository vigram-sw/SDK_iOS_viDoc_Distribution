{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"What is the new on this release","type":"heading","level":2,"anchor":"What-is-the-new-on-this-release"},{"text":"HotFix changes","type":"heading","level":4,"anchor":"HotFix-changes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fix issue with scan viDoc device in BluetoothService"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fix issue with reconnect method in NtripTask"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fix issue with throw error - enter incorrent data (port) in NtripConnectionInformation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Refactoring resume and disconnect methods in NtripTask. The service is now more stable."},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"Note:","type":"text"}]},{"type":"text","text":" The method "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripTask\/cancel()","isActive":true},{"type":"text","text":" is marked as deprecated. Use the "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripTask\/disconnect()","isActive":true},{"type":"text","text":" method to disconnect from the NTRIP service and "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/GPSService\/reconnect()","isActive":true},{"type":"text","text":" method to reconnect to the NTRIP service."},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Important","type":"text"}]},{"type":"text","text":" To connect to the NTRIP service you must use the method "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/NtripTask\/resume()","isActive":true},{"type":"text","text":". Do not use for these purposes the method "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/docume