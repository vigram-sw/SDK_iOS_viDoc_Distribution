{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UsePPKMeasurements"},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"Article","title":"Use UBX PPK Measurements","modules":[{"name":"VigramSDK"}],"images":[{"type":"icon","identifier":"logo.png"}],"role":"article"},"primaryContentSections":[{"content":[{"level":2,"text":"","anchor":"","type":"heading"},{"inlineContent":[{"text":"If you need use PPK Measurements first need to activate RXM messages, performing this method:","type":"text"}],"type":"paragraph"},{"code":["peripheral.changeStatusRXM(activate: Bool)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Note: activate - enable \/ disable RXM messages","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To receive UBX-RXM-RAWX or UBX-RXM-SFRBX messages use:"}]},{"type":"codeListing","code":["peripheral.satelliteMessages.sink(receiveValue: { satelliteMessage in","    switch satelliteMessage {","        case let .rawx(rawxMessage):","            \/\/ do something with rawxMessage","        case let .sfrbx(sfrbxMessage):","            \/\/ do something with sfrbxMessage","        default:","            break","        }","    }).store(in: &subscription)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If need to record PPK measurement to file, first create URL path for ubx file."},{"type":"text","text":" "},{"type":"text","text":"Example:"}]},{"type":"codeListing","code":["var path: URL? \/\/ Path for logger file.","\/\/ For example let file = \"file.ubx\"","let file = \"Filename\" + \".\" + \"file extension\" ","","let fileManager = FileManager.default","let directory = fileManager.urls(","    for: .documentDirectory, ","    in: .userDomainMask",")","","if directory.count != 0  {","    path = directory[0].appendingPathComponent(\"Name directory\")","    if let path = path?.path {","        if !fileManager.fileExists(atPath: path) {","            do {","                try fileManager.createDirectory(","                    atPath: path, ","                    withIntermediateDirectories: true, ","                    attributes: nil","                )","            } catch {","                print(\"Error: \\(error.localizedDescription)\")","            }","        }","    }","    path = path?.appendingPathComponent(file)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"After then, start record measurements perform this method","type":"text"}]},{"type":"codeListing","code":["peripheral.startRecordPPKMeasurements(url: ubxFilePath)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Record is active.","type":"text"},{"text":" ","type":"text"},{"text":"If you need to stop record measurements perform this method","type":"text"}]},{"type":"codeListing","code":["peripheral.stopRecordPPKMeasurements()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All messages will saving to file"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/vigramsdk\/useppkmeasurements"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://com.vigram.sdk/documentation/VigramSDK":{"images":[{"type":"icon","identifier":"logo.png"}],"url":"\/documentation\/vigramsdk","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","type":"topic","kind":"symbol","abstract":[],"role":"collection","title":"VigramSDK"},"logo.png":{"identifier":"logo.png","alt":"Vigram logo.","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/com.vigram.sdk\/logo.png"}]}}}