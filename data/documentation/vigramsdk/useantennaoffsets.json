{"primaryContentSections":[{"kind":"content","content":[{"anchor":"","type":"heading","level":2,"text":""},{"type":"paragraph","inlineContent":[{"text":"Antenna offsets are the offset of the camera relative to the antenna attached to viDoc for a specific device.","type":"text"},{"text":" ","type":"text"},{"text":"Depending on the device used, we return the specific camera offset that works best.","type":"text"}]},{"anchor":"","type":"heading","level":2,"text":""},{"type":"paragraph","inlineContent":[{"text":"The following offset options exist:","type":"text"}]},{"code":["public enum AntennaOffset {","    case Camera \/\/ This type of offset will be removed in future versions ","                \/\/ of the SDK.","    case SPC \/\/ For viDoc with SPC case","    case SPCPlus \/\/ For viDoc with SPC+ case","    case SPCPlusLight \/\/ For viDoc Light with SPC+ case","    case Laser \/\/ The laser offset in relation to the antenna's position","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Constants used in measurements:","type":"text"}]},{"code":["\/\/ The middle antenna height (by default).","\/\/","\/\/ Distance from the bottom of the antenna to the center (cm).","\/\/","\/\/ Available from SDK: 0.5.3","Configuration.middleAntenna: Double = 3.57","","","\/\/ The device height (by default).","\/\/","\/\/ Distance from the bottom of the device to the center (cm).","\/\/","\/\/ Available from SDK: 0.5.3","Configuration.deviceHeight: Double = 15.2"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The offset of different device components in relation to the antenna’s position for various devices.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Assuming the device is in portrait mode.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"X-Offset: (-) Left -> Right (+) of the device."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Y-Offset: (-) Bottom -> Top (+) of the device."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Z-Offset: (-) Back -> Front (+) of the device."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"An example of offsets for iPhone 12 Pro, 12 Pro Max is presented below","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"15.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"identifier":"16.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"Example of using offsets in ","type":"text"},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step8SinglePoint","overridingTitle":"Single point measurements","overridingTitleInlineContent":[{"text":"Single point measurements","type":"text"}],"isActive":true,"type":"reference"},{"text":" with Laser","type":"text"}]},{"code":["\/\/ Bottom laser selected","let typeOfLaser: LaserConfiguration.Position = .bottom ","","\/\/ Laser measurement mode - fast","let laserShotMode: LaserConfiguration.ShotMode = .fast ","","\/\/ Measurement duration (in seconds). ","\/\/ For viDoc protocol version < 2, the measurement duration","\/\/ must be in the range [5...60] seconds.","\/\/","\/\/ For protocol >= 2, any value can be specified. If 0 is ","\/\/ specified, the measurement will continue ","\/\/ indefinitely.","\/\/ ","\/\/ More details in section №8 (Using Single point measurements)","let duration: Double = 30","","\/\/ Creating a laser configuration. ","\/\/ The laser configuration. Keep in mind, that you will not receive ","\/\/ further environment data values after the laser duration has passed.","let laserConfig = LaserConfiguration.init(shotMode: laserShotMode, ","                                          position: typeOfLaser, ","                                          duration: duration)","","\/\/ Antenna offset","\/\/ The offset of the laser in relation to the antenna position. ","\/\/ Use values from AntennaOffset here.","let currentOffsets = AntennaOffset.Laser.iPhone14ProMaxBottom","","\/\/ Measurement method","\/\/ UseDeviceMotion - This attribute specifies whether to incorporate ","\/\/ the device motion into the calculation of the corrected coordinate. ","\/\/ This allows to not only correct coordinates by strictly subtracting ","\/\/ the laser distance measurement from the measured antenna position,","\/\/ but rather enables diagonally held laser measurements as well.","let method = ","    CoordinateCorrection.Method.laser(configuration: laserConfig, ","                                      antennaOffset: offset,","                                      useDeviceMotion: true)","","\/\/ Creates an EnvironmentDataService to keep track of all the environment ","\/\/ information from the device’s internal sensors and possible values  ","\/\/ from the viDoc sensors.","\/\/","\/\/ DynamicStateType - Pedestrian or Stationary type of dynamic state","let environmentDataService = ","    Vigram.environmentDataService(gpsService: gpsService!, ","                                  laserService: laserService!,","                                  peripheral: peripheral!, ","                                  dynamicStateType: .stationary)","","\/\/ Create SinglePoint Recording Service","let singlePointRecordingService = ","    Vigram.singlePointRecordingService(environmentDataService: ","                                        environmentDataService!)","","let cancellable = singlePointRecordingService!","    .startMeasurement(duration: duration, ","                      updateInterval: 0.1, with: method)","    .sink { completion in","        switch completion {","        case .failure(let error):","            \/\/ Do something with error","        case .finished:","            break","        }","    } receiveValue: { singlePoint in","        \/\/ Do something with singlePoint","    }"],"syntax":"swift","type":"codeListing"},{"anchor":"More-information-about","type":"heading","level":3,"text":"More information about"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step5WorkWithPeripheral","overridingTitle":"Peripheral","isActive":true,"type":"reference","overridingTitleInlineContent":[{"text":"Peripheral","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step6UsingNTRIP","overridingTitle":"GPSService","isActive":true,"type":"reference","overridingTitleInlineContent":[{"text":"GPSService","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step7LaserService","overridingTitle":"LaserService","isActive":true,"type":"reference","overridingTitleInlineContent":[{"text":"LaserService","type":"text"}]}]}]},{"content":[{"inlineContent":[{"type":"reference","overridingTitle":"Single point measurements","overridingTitleInlineContent":[{"type":"text","text":"Single point measurements"}],"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step8SinglePoint"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Note: Offsets have a data type ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/swift\/simd3","isActive":true,"type":"reference"}]},{"type":"paragraph","inlineContent":[{"text":"You can set your own custom offsets","type":"text"}]},{"code":["let yourCustomOffset = SIMD3(x: 4.4, y: -1.6, z: 2) \/ 100"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Example of using offsets in ","type":"text"},{"type":"reference","overridingTitle":"Single point measurements","overridingTitleInlineContent":[{"text":"Single point measurements","type":"text"}],"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step8SinglePoint"},{"text":" without Laser","type":"text"}]},{"code":["\/\/ The distance from the antenna to the ground to subtract from the ","\/\/ antenna’s coordinate’s altitude.","let distanceToGround = Double(distanceToGround)","","\/\/ Antenna offset","\/\/ The offset of the laser in relation to the antenna position. ","\/\/ Use values from AntennaOffset here.","let currentOffsets = AntennaOffset.SPC.iPhone14ProMaxBottom","","\/\/ Measurement method","\/\/ When using the constant height coordinate correction,","\/\/ the correctedCoordinate property of EnvironmentData will reflect ","\/\/ the position of the antenna with an altitude subtracted by the ","\/\/ constant value.","let method = ","    CoordinateCorrection.Method","        .constant(distanceFromAntennaToGround: antennaDistanceToGround)","","\/\/ Creates an EnvironmentDataService to keep track of all the environment ","\/\/ information from the device’s internal sensors and possible values  ","\/\/ from the viDoc sensors.","\/\/","\/\/ DynamicStateType - Pedestrian or Stationary type of dynamic state","let environmentDataService = ","    Vigram.environmentDataService(gpsService: gpsService!, ","                                  peripheral: peripheral!, ","                                  dynamicStateType: .stationary)","","\/\/ Create SinglePoint Recording Service","let singlePointRecordingService = ","    Vigram.singlePointRecordingService(environmentDataService: ","                                        environmentDataService!)","","let cancellable = singlePointRecordingService!","    .startMeasurement(duration: duration, ","                      updateInterval: 0.1, with: method)","    .sink { completion in","        switch completion {","        case .failure(let error):","            \/\/ Do something with error","        case .finished:","            break","        }","    } receiveValue: { singlePoint in","        \/\/ Do something with singlePoint","    }"],"syntax":"swift","type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","variants":[{"paths":["\/documentation\/vigramsdk\/useantennaoffsets"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"VigramSDK"}],"roleHeading":"Article","title":"Use Antenna Offsets","role":"article","images":[{"type":"icon","identifier":"logo.png"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseAntennaOffsets"},"sections":[],"references":{"doc://com.vigram.sdk/documentation/VigramSDK/Step8SinglePoint":{"images":[{"identifier":"logo.png","type":"icon"}],"abstract":[],"title":"Using Single point measurements","role":"article","url":"\/documentation\/vigramsdk\/step8singlepoint","kind":"article","type":"topic","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step8SinglePoint"},"doc://com.vigram.sdk/documentation/VigramSDK/Step6UsingNTRIP":{"images":[{"type":"icon","identifier":"logo.png"}],"abstract":[],"title":"Using NTRIP correction","role":"article","url":"\/documentation\/vigramsdk\/step6usingntrip","kind":"article","type":"topic","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step6UsingNTRIP"},"doc://com.vigram.sdk/documentation/VigramSDK/Step7LaserService":{"images":[{"identifier":"logo.png","type":"icon"}],"abstract":[],"title":"Using Laser service","role":"article","url":"\/documentation\/vigramsdk\/step7laserservice","kind":"article","type":"topic","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step7LaserService"},"doc://com.vigram.sdk/documentation/VigramSDK/Step5WorkWithPeripheral":{"url":"\/documentation\/vigramsdk\/step5workwithperipheral","role":"article","abstract":[],"title":"Work with viDoc (Peripheral)","kind":"article","images":[{"type":"icon","identifier":"logo.png"}],"type":"topic","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step5WorkWithPeripheral"},"16.png":{"identifier":"16.png","variants":[{