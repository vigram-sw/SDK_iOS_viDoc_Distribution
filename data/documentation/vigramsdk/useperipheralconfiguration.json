{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"","text":"","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to disable some GNSS messages, change the message rate, or change the minimum elevation used in navigation parameters, create a "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralConfiguration","isActive":true},{"type":"text","text":" and pass it to the peripheral initializer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"code":["let peripheralConfiguration =","    PeripheralConfiguration(rateOfChangeMessages: .hertz1,","                            glonassActivate: false)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then pass the configuration to the peripheral initializer:","type":"text"}]},{"code":["\/\/ If use support logger, configure it once with Vigram.Logger(...)","\/\/ and then create the peripheral normally","let sdkPeripheral =","    Vigram.peripheral(cbPeripheral,","                      configuration: peripheralConfiguration)","","\/\/ Without a custom configuration","let defaultPeripheral = Vigram.peripheral(cbPeripheral)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Note: If this parameter is not passed to the initializer, all parameters will use their default values.","type":"text"}]},{"code":["\/\/ Message rate is set to 7 hertz","rateOfChangeMessages: RateValue = .hertz7","","\/\/ Minimum elevation used in navigation is set to 10 degrees","elevationValue: ElevationValue = .ang10,","","\/\/ All satellite constellations are active","glonassActivate = true","beidouActivate = true","galileoActivate = true","qzssActivate = true","sbassActivate = true","","\/\/ NAV-DOP and NAV-PVT messages are active","navDOPActivate = true","navPVTActivate = true","","\/\/ Dynamic state mode","dynamicType = .pedestrian"],"syntax":"swift","type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vigramsdk\/useperipheralconfiguration"]}],"metadata":{"modules":[{"name":"VigramSDK"}],"title":"Use Peripheral Configuration","role":"article","roleHeading":"Article","images":[{"type":"icon","identifier":"logo.png"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UsePeripheralConfiguration"},"references":{"doc://com.vigram.sdk/documentation/VigramSDK":{"type":"topic","url":"\/documentation\/vigramsdk","role":"collection","abstract":[],"kind":"symbol","images":[{"type":"icon","identifier":"logo.png"}],"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","title":"VigramSDK"},"logo.png":{"identifier":"logo.png","type":"image","alt":"Vigram logo.","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}]},"doc://com.vigram.sdk/documentation/VigramSDK/PeripheralConfiguration":{"url":"\/documentation\/vigramsdk\/peripheralconfiguration","type":"topic","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralConfiguration","title":"PeripheralConfiguration","kind":"symbol","abstract":[{"type":"text","text":"Initial configuration for peripheral"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PeripheralConfiguration"}],"navigatorTitle":[{"kind":"identifier","text":"PeripheralConfiguration"}],"role":"symbol"}}}