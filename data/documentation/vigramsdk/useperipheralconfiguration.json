{"hierarchy":{"paths":[["doc:\/\/com.vigram.sdk\/documentation\/VigramSDK"]]},"kind":"article","identifier":{"url":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UsePeripheralConfiguration","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"roleHeading":"Article","images":[{"type":"icon","identifier":"logo.png"}],"modules":[{"name":"VigramSDK"}],"role":"article","title":"Use Peripheral Configuration"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"","text":"","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you need to disable some GNSS messages, change the message rate, or change the minimum elevation used in navigation parameters, create a "},{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralConfiguration","isActive":true,"type":"reference"},{"type":"text","text":" and pass it to the peripheral initializer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"type":"codeListing","syntax":"swift","code":["let peripheralConfiguration =","    PeripheralConfiguration(rateOfChangeMessages: .hertz1,","                            glonassActivate: false)"]},{"type":"paragraph","inlineContent":[{"text":"Then pass the configuration to the peripheral initializer:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ If use support logger, configure it once with Vigram.Logger(...)","\/\/ and then create the peripheral normally","let sdkPeripheral =","    Vigram.peripheral(cbPeripheral,","                      configuration: peripheralConfiguration)","","\/\/ Without a custom configuration","let defaultPeripheral = Vigram.peripheral(cbPeripheral)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note: If this parameter is not passed to the initializer, all parameters will use their default values."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Message rate is set to 7 hertz","rateOfChangeMessages: RateValue = .hertz7","","\/\/ Minimum elevation used in navigation is set to 10 degrees","elevationValue: ElevationValue = .ang10,","","\/\/ All satellite constellations are active","glonassActivate = true","beidouActivate = true","galileoActivate = true","qzssActivate = true","sbassActivate = true","","\/\/ NAV-DOP and NAV-PVT messages are active","navDOPActivate = true","navPVTActivate = true","","\/\/ Dynamic state mode","dynamicType = .pedestrian"]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/vigramsdk\/useperipheralconfiguration"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"logo.png":{"identifier":"logo.png","type":"image","variants":[{"url":"\/images\/com.vigram.sdk\/logo.png","traits":["1x","light"]}],"alt":"Vigram logo."},"doc://com.vigram.sdk/documentation/VigramSDK/PeripheralConfiguration":{"navigatorTitle":[{"kind":"identifier","text":"PeripheralConfiguration"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PeripheralConfiguration"}],"title":"PeripheralConfiguration","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/PeripheralConfiguration","abstract":[{"type":"text","text":"Initial configuration for peripheral"}],"url":"\/documentation\/vigramsdk\/peripheralconfiguration","type":"topic","role":"symbol"},"doc://com.vigram.sdk/documentation/VigramSDK":{"images":[{"type":"icon","identifier":"logo.png"}],"url":"\/documentation\/vigramsdk","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK","type":"topic","kind":"symbol","abstract":[],"role":"collection","title":"VigramSDK"}}}