for the measurement duration was 5…60. There was also no possibility to interrupt a measurement that had already started."}],"type":"paragraph"},{"inlineContent":[{"text":"For start measurement, perform this method","type":"text"}],"type":"paragraph"},{"code":["singlePointService","    .record(duration: duration, ","            updateInterval: updateInterval, ","            with: method)","    .sink(receiveCompletion: { completion in ","        switch completion {","        case .finished:","            \/\/ Value successfully received","            \/\/ You can use this state for any further actions ","            \/\/ after receiving the values.","            break","        case let .failure(error):","            \/\/ Error getting value","            \/\/ Do something with error","            print(error.localizedDescription)","        }","    }) { singlePointValue in","        \/\/ do somethind with singlePointValue","    }.store(in: &subscription)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Receive value:","type":"text"}]},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePoint"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Throw error:"}],"type":"strong"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePointRecordingError","type":"reference"}],"type":"paragraph"},{"level":3,"text":"More information about","type":"heading","anchor":"More-information-about"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePoint"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/EnvironmentData","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/EnviromentDataService","overridingTitle":"EnviromentDataService","type":"reference","overridingTitleInlineContent":[{"text":"EnviromentDataService","type":"text"}],"isActive":true}]}]},{"content":[{"inlineContent":[{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"GPSService"}],"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step6UsingNTRIP","type":"reference","overridingTitle":"GPSService"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"overridingTitleInlineContent":[{"text":"LaserService","type":"text"}],"type":"reference","isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/Step7LaserService","overridingTitle":"LaserService"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"overridingTitleInlineContent":[{"text":"Use GPSCoordinate + Transformation","type":"text"}],"isActive":true,"type":"reference","overridingTitle":"Use GPSCoordinate + Transformation","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/GPSCoordinate"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/UseCombineAndPublishers","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Using Combine and Publishers"}],"isActive":true,"overridingTitle":"Using Combine and Publishers"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"New-protocol-methods","text":"New protocol methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The new version of the protocol has no restrictions on measurement time."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note: If set the duration value to 0, the measurement will go on infinity. If need to terminate measurements, perform the method stopMeasurement."},{"type":"text","text":" "},{"type":"text","text":"(Available only on the new protocol - HW of viDoc 0.2.1.(12) and up)"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example:"}]},{"type":"codeListing","syntax":"swift","code":["singlePointRecordingService","    .startMeasurement()","    .sink(receiveCompletion: { completion in ","        switch completion {","        case .finished:","            \/\/ Value successfully received","            \/\/ You can use this state for any further actions ","            \/\/ after receiving the values.","            break","        case let .failure(error):","            \/\/ Error getting value","            \/\/ Do something with error","            print(error.localizedDescription)","        }","    }) { singlePointValue in","        \/\/ do somethind with singlePointValue","    }.store(in: &subscription)"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Receive value:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePoint","isActive":true}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Throw error:","type":"text"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePointRecordingError","isActive":true}]},{"type":"heading","level":3,"text":"More information about","anchor":"More-information-about"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/SinglePoint","type":"reference"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/EnvironmentData","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.vigram.sdk\/documentation\/VigramSDK\/EnviromentDataService","overridingTitle":"EnviromentDataService","overridingTitleInlineContent":[{"type":